# Azure AI Foundry
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=

# X OAuth 2.0
X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_API_BASE_URL=https://api.x.com/2
X_REDIRECT_URI=http://127.0.0.1:8003/api/v1/integrations/x/callback
X_OAUTH_SCOPES=users.read tweet.read dm.read dm.write offline.access
# Optional dedicated Fernet key; when blank, local development derives it from the Supabase server key.
X_TOKEN_ENCRYPTION_KEY=

# Supabase browser-safe configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase backend configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
